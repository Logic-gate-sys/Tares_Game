{
    "name": "web-client",
    "private": true,
    "version": "0.0.0",
    "main": "./src/main.tsx",
    "type": "module",
    "scripts": {
        "dev": "concurrently --kill-others -n backend-compose,client -c magenta,green \"npm:start:backend\"  \"npm:dev:client\" ",
        "dev:client": "vite ",
        "start:backend": "cd .. && docker compose --profile dev up --build --remove-orphans user-db game-db redis user-service wss-service dev-gateway",
        "test": "vitest run --coverage",
        "build": "tsc -b && vite build",
        "lint": "eslint . --fix",
        "preview": "vite preview"
    },
    "dependencies": {
        "@reduxjs/toolkit": "^2.12.0",
        "@tailwindcss/vite": "^4.3.1",
        "axios": "^1.18.1",
        "gsap": "^3.15.0",
        "lucide-react": "^1.22.0",
        "react": "^19.2.7",
        "react-dom": "^19.2.7",
        "react-redux": "^9.3.0",
        "react-router-dom": "^7.18.1",
        "tailwindcss": "^4.3.1",
        "zed": "^0.1.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^24.13.2",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^6.0.2",
        "@vitest/browser-playwright": "^5.0.0",
        "@vitest/coverage-v8": "^4.1.9",
        "concurrently": "^10.0.4",
        "eslint": "^10.5.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.3",
        "globals": "^17.6.0",
        "typescript": "~6.0.2",
        "typescript-eslint": "^8.61.0",
        "vite": "^8.1.0",
        "vitest": "^5.0.0"
    }
}
